{
    "name": "@ostro/encryption",
    "version": "2.0.0-alpha.1",
    "description": "Encryption module for OstroJS",
    "main": "build/encrypter.js",
    "types": "build/encrypter.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/encrypter.d.ts",
            "default": "./build/encrypter.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest --runInBand --no-coverage --forceExit",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "bcrypt": "^5.1.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "encryption",
        "hashing"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/encryption.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/encryption/issues"
    },
    "homepage": "https://github.com/ostrojs/encryption#readme",
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
